<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>I'm Sorry, Rida</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Poppins:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,500;1,500;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --indigo-deep:#352A63;
    --violet-mid:#6E5FC4;
    --lavender-soft:#C6BCEE;
    --sky:#9FC2E8;
    --blush:#F2F0FB;
    --paper:#FDFCFF;
    --ink:#2E2650;
    --shadow-soft: rgba(53,42,99,0.18);
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior:smooth;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--blush);
    color:var(--ink);
    font-family:'Poppins', sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --blush:#1C1830;
      --paper:#241F3B;
      --ink:#E9E5FA;
      --shadow-soft: rgba(0,0,0,0.45);
    }
  }
  :root[data-theme="dark"]{
    --blush:#1C1830;
    --paper:#241F3B;
    --ink:#E9E5FA;
    --shadow-soft: rgba(0,0,0,0.45);
  }

  ::selection{ background:var(--violet-mid); color:#fff; }

  .particles{ position:fixed; inset:0; pointer-events:none; z-index:1; overflow:hidden; }
  .particle{
    position:absolute; bottom:-30px; width:10px; height:10px; opacity:0.5;
    animation: drift-up linear infinite;
  }
  .particle svg{ width:100%; height:100%; display:block; }
  @keyframes drift-up{
    0%{ transform:translateY(0) translateX(0) rotate(0deg); opacity:0; }
    12%{ opacity:0.55; }
    88%{ opacity:0.35; }
    100%{ transform:translateY(-108vh) translateX(var(--drift,16px)) rotate(180deg); opacity:0; }
  }

  section{ position:relative; z-index:2; }
  .wrap{ max-width:720px; margin:0 auto; padding:12vh 7vw; }
  .kicker{
    font-family:'Cormorant Garamond', serif; font-style:italic;
    color:var(--violet-mid); font-size:1.1rem; margin-bottom:0.4rem; text-align:center;
  }
  h2.section-title{
    font-family:'Playfair Display', serif; font-weight:600;
    font-size:clamp(1.7rem, 4.4vw, 2.4rem);
    color:var(--indigo-deep);
    text-align:center;
    margin:0 0 2.6rem;
  }

  /* ---------- Hero ---------- */
  .hero{
    min-height:100vh; display:flex; flex-direction:column;
    align-items:center; justify-content:center; text-align:center;
    padding:8vh 6vw;
  }
  .hero .eyebrow{
    font-family:'Cormorant Garamond', serif; font-style:italic;
    font-size:clamp(1rem, 2.3vw, 1.3rem); color:var(--violet-mid);
    margin-bottom:0.6rem; opacity:0; animation: rise 1s ease-out 0.2s forwards;
  }
  .hero h1{
    font-family:'Playfair Display', serif; font-weight:700;
    font-size:clamp(2.4rem, 8.5vw, 4.6rem); line-height:1.08;
    margin:0; color:var(--indigo-deep);
    opacity:0; animation: rise 1s ease-out 0.5s forwards;
  }
  @keyframes rise{ from{ opacity:0; transform:translateY(18px); } to{ opacity:1; transform:translateY(0); } }
  .hero p.tagline{
    font-family:'Cormorant Garamond', serif; font-style:italic;
    font-size:clamp(1.05rem, 2.5vw, 1.35rem); max-width:34ch; line-height:1.65;
    margin-top:1.4rem; opacity:0; animation: rise 1s ease-out 1s forwards;
  }
  .scroll-cue{
    margin-top:3rem; width:1px; height:50px;
    background:linear-gradient(var(--violet-mid), transparent); position:relative;
    opacity:0; animation: rise 1s ease-out 1.5s forwards;
  }
  .scroll-cue::after{
    content:""; position:absolute; left:50%; top:0; transform:translateX(-50%);
    width:6px; height:6px; border-radius:50%; background:var(--violet-mid);
    animation: drip 1.8s ease-in-out infinite;
  }
  @keyframes drip{ 0%{ top:0; opacity:1; } 80%{ opacity:0.6; } 100%{ top:44px; opacity:0; } }

  /* ---------- Reflection ---------- */
  .reflection p{
    font-family:'Cormorant Garamond', serif; font-size:1.22rem; line-height:1.85;
    color:var(--ink); max-width:60ch; margin:0 auto 1.1rem; text-align:center;
  }
  .reflection p:last-child{ margin-bottom:0; }

  /* ---------- Envelope / letter ---------- */
  .envelope-stage{ display:flex; flex-direction:column; align-items:center; }
  .envelope{
    --w: min(300px, 70vw); width:var(--w); aspect-ratio:3/2; position:relative;
    cursor:pointer; filter:drop-shadow(0 16px 28px var(--shadow-soft));
    transition: transform .4s ease;
  }
  .envelope:hover{ transform:translateY(-4px); }
  .envelope .back{
    position:absolute; inset:0; border-radius:10px;
    background: linear-gradient(160deg, var(--violet-mid), var(--indigo-deep));
  }
  .envelope .letter-peek{
    position:absolute; left:8%; right:8%; top:-6%; height:80%;
    background:var(--paper); border-radius:6px; box-shadow:0 4px 10px rgba(0,0,0,0.12);
    transition: transform .6s cubic-bezier(.2,.7,.3,1); transform:translateY(0%); z-index:1;
  }
  .envelope.open .letter-peek{ transform:translateY(-58%); }
  .flap{
    position:absolute; top:0; left:0; right:0; height:56%;
    background: linear-gradient(160deg, var(--indigo-deep), #23194a);
    clip-path: polygon(0 0, 100% 0, 50% 68%);
    transform-origin:top; transition: transform .5s ease; z-index:3; border-radius:10px 10px 0 0;
  }
  .envelope.open .flap{ transform:rotateX(180deg); }
  .seal{
    position:absolute; left:50%; top:34%; transform:translate(-50%,-50%);
    width:44px; height:44px; border-radius:50%;
    background: radial-gradient(circle at 35% 30%, var(--sky), #4a6f96);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 3px 8px rgba(0,0,0,0.25); z-index:4; font-size:1rem; color:#fff;
    transition: opacity .3s ease, transform .3s ease;
  }
  .envelope.open .seal{ opacity:0; transform:translate(-50%,-50%) scale(0.5); }
  .envelope-hint{
    font-family:'Cormorant Garamond', serif; font-style:italic;
    margin-top:1.5rem; color:var(--violet-mid); font-size:1.02rem; opacity:0.9;
  }
  .letter{
    max-width:540px; margin:2.4rem auto 0; background:var(--paper); border-radius:12px;
    padding:2.5rem 2.3rem; box-shadow:0 16px 36px var(--shadow-soft);
    font-family:'Cormorant Garamond', serif; font-size:1.16rem; line-height:1.85; color:var(--ink);
    max-height:0; opacity:0; overflow:hidden;
    transition: max-height .8s ease, opacity .8s ease;
  }
  .letter.show{ max-height:900px; opacity:1; }
  .letter p{ margin:0 0 1.1rem; }
  .letter p:last-child{ margin-bottom:0; }
  .letter .sign{ font-style:italic; color:var(--violet-mid); margin-top:1.3rem; display:block; }

  /* ---------- Promise cards ---------- */
  .promise-grid{ display:grid; grid-template-columns:1fr 1fr; gap:1rem; max-width:560px; margin:0 auto; }
  .promise-card{ perspective:1200px; height:160px; cursor:pointer; outline:none; }
  .promise-inner{
    position:relative; width:100%; height:100%; transform-style:preserve-3d;
    transition: transform .6s cubic-bezier(.3,.7,.3,1);
  }
  .promise-card.flipped .promise-inner{ transform:rotateY(180deg); }
  .promise-front, .promise-back{
    position:absolute; inset:0; backface-visibility:hidden; border-radius:14px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:1rem; box-shadow:0 10px 22px var(--shadow-soft);
  }
  .promise-front{ background:var(--paper); border:1.5px solid var(--lavender-soft); }
  .promise-front span{ font-size:1.6rem; margin-bottom:0.4rem; }
  .promise-front p{
    font-family:'Cormorant Garamond', serif; font-style:italic; color:var(--indigo-deep);
    font-size:1.02rem; text-align:center; margin:0;
  }
  .promise-back{
    background: linear-gradient(160deg, var(--violet-mid), var(--indigo-deep));
    transform:rotateY(180deg);
  }
  .promise-back p{
    font-family:'Cormorant Garamond', serif; font-style:italic; color:#f3f0ff;
    font-size:0.98rem; line-height:1.5; text-align:center; margin:0;
  }

  /* ---------- Forgive game ---------- */
  .forgive-stage{
    position:relative; max-width:380px; height:140px; margin:0 auto 1rem;
  }
  .forgive-yes, .forgive-no{
    position:absolute; top:50%; transform:translateY(-50%);
    border:none; border-radius:999px; padding:0.85rem 1.9rem; font-size:1rem;
    cursor:pointer; font-family:'Poppins', sans-serif;
  }
  .forgive-yes{
    left:50%; transform:translate(-110%,-50%);
    background:var(--violet-mid); color:#fff; box-shadow:0 10px 22px var(--shadow-soft);
    transition: transform .25s ease, background .25s ease;
  }
  .forgive-yes:hover{ background:var(--indigo-deep); }
  .forgive-no{
    left:50%; transform:translate(10%,-50%);
    background:var(--paper); color:var(--ink); border:1.5px solid var(--lavender-soft);
    transition: left .3s ease, top .3s ease, opacity .3s ease;
  }
  .forgive-no.gone{ opacity:0; pointer-events:none; }
  .forgive-result{
    text-align:center; font-family:'Cormorant Garamond', serif; font-style:italic;
    color:var(--ink); min-height:1.6em; margin-top:0.6rem; font-size:1.1rem;
  }

  /* ---------- Closing ---------- */
  .closing{ text-align:center; padding-bottom:16vh; position:relative; overflow:hidden; }
  .closing::before{
    content:""; position:absolute; left:50%; top:18%; width:260px; height:260px;
    transform:translate(-50%,-50%) scale(1); border-radius:50%;
    background: radial-gradient(circle, rgba(159,194,232,0.35), transparent 70%);
    filter: blur(6px); animation: glow-pulse 4.5s ease-in-out infinite; z-index:0;
  }
  .closing > *{ position:relative; z-index:1; }
  @keyframes glow-pulse{
    0%,100%{ opacity:0.4; transform:translate(-50%,-50%) scale(1); }
    50%{ opacity:0.8; transform:translate(-50%,-50%) scale(1.16); }
  }
  .heart-mark{ width:32px; height:32px; margin:0 auto 1.4rem; color:var(--violet-mid); animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.14); } }
  .closing blockquote{
    font-family:'Playfair Display', serif; font-style:italic; font-weight:500;
    font-size:clamp(1.25rem, 3.2vw, 1.75rem); color:var(--indigo-deep);
    max-width:30ch; margin:0 auto 1.4rem; line-height:1.45;
  }
  .closing .from{ font-family:'Cormorant Garamond', serif; font-style:italic; color:var(--ink); font-size:1.1rem; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
  }
</style>
</head>
<body>

<div class="particles" id="particles" aria-hidden="true"></div>

<section class="hero">
  <div class="eyebrow">ek chhoti si baat</div>
  <h1>I'm sorry, Rida</h1>
  <p class="tagline">pata hai lafzon se sab theek nahi hota, par shuruaat yahin se karna chahta hoon.</p>
  <div class="scroll-cue"></div>
</section>

<section class="wrap reflection">
  <div class="kicker">sach mein</div>
  <h2 class="section-title">jo baat maanta hoon</h2>
  <p>Humare beech jo ladaiyan hoti hain, unme zyada waqt galti meri hi hoti hai — chhoti baat ko bada bana dena, sunne se pehle bol dena. Ye pattern mujhe bhi dikhta hai, aur main ise theek karna chahta hoon.</p>
  <p>Pichli baaton ko yaad karke dobara wahi gussa nikal dena bhi galat tha. Tumhe utna sunna chahiye tha jitna tumne mujhe sunwaya.</p>
  <p>Mujhe pata hai sirf "sorry" kehna kaafi nahi hai — asli baat ye hai ki hum jo bhi gadbad hoti hai, use theek se, shanti se baithke clear karein. Yehi karna chahta hoon ab.</p>
</section>

<section class="wrap">
  <div class="kicker">ek khat</div>
  <h2 class="section-title">jo keh nahi paaya seedha</h2>
  <div class="envelope-stage">
    <div class="envelope" id="envelope" role="button" tabindex="0" aria-label="Open the letter">
      <div class="back"></div>
      <div class="letter-peek"></div>
      <div class="flap"></div>
      <div class="seal">✧</div>
    </div>
    <div class="envelope-hint" id="hint">seal khol ke padho, Rida</div>

    <div class="letter" id="letter">
      <p>Rida,</p>
      <p>Mujhe pata hai hum dono ladte zyada hain, aur zyada baar shuruaat ya badhaava mere taraf se hota hai. Chhoti si baat ko main bada bana deta hoon, aur phir sunne ki jagah bas apni baat sabit karne mein lag jaata hoon.</p>
      <p>Tumhe aisa mehsoos karwaya jaise tumhari baat kam matter karti hai — jabki sach ye hai ki main sabse zyada tumhari hi baat sunna chahta hoon, bas tarika galat hota hai.</p>
      <p>Aage se koshish karunga ki gussa thanda hoke baat karu, tumhe pehle sunoon, aur jo bhi gadbad ho use turant, saaf tarike se clear kar loon — bina kisi baat ko dabaye ya baad ke liye chhod ke.</p>
      <p>Sorry, sach mein. Aur agar abhi bhi kuch clear karna ho, toh main sunne ko taiyar hoon.</p>
      <span class="sign">tumhara, Ahzaz</span>
    </div>
  </div>
</section>

<section class="wrap">
  <div class="kicker">ab se aisa karunga</div>
  <h2 class="section-title">kuch waade</h2>
  <div class="promise-grid">
    <div class="promise-card" tabindex="0">
      <div class="promise-inner">
        <div class="promise-front"><span>🧘</span><p>pehle thanda hounga</p></div>
        <div class="promise-back"><p>Gussa aaye toh pehle shaant hounga, phir baat karunga — jaldi mein kuch galat nahi kahunga.</p></div>
      </div>
    </div>
    <div class="promise-card" tabindex="0">
      <div class="promise-inner">
        <div class="promise-front"><span>👂</span><p>pehle sunoonga</p></div>
        <div class="promise-back"><p>Apni baat rakhne se pehle, poora dhyaan se sunoonga ki tum kya kehna chahti ho.</p></div>
      </div>
    </div>
    <div class="promise-card" tabindex="0">
      <div class="promise-inner">
        <div class="promise-front"><span>🧩</span><p>turant clear karunga</p></div>
        <div class="promise-back"><p>Koi bhi gadbad ho, use dabaunga nahi — usi din, saaf tarike se baat karke sulzhaunga.</p></div>
      </div>
    </div>
    <div class="promise-card" tabindex="0">
      <div class="promise-inner">
        <div class="promise-front"><span>🤝</span><p>ego side mein</p></div>
        <div class="promise-back"><p>Jeetne ki koshish nahi karunga — hum dono ek team hain, sahi-galat se zyada zaroori hum hain.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="wrap" style="text-align:center;">
  <div class="kicker">ek chhota sawaal</div>
  <h2 class="section-title">maaf karogi?</h2>
  <div class="forgive-stage" id="forgiveStage">
    <button class="forgive-yes" id="forgiveYes" type="button">haan</button>
    <button class="forgive-no" id="forgiveNo" type="button">nahi</button>
  </div>
  <p class="forgive-result" id="forgiveResult">&nbsp;</p>
</section>

<section class="closing">
  <svg class="heart-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 21s-7.5-4.6-10.2-9.1C.2 9.1 1.2 5.6 4.4 4.5c2-.7 4 .1 5.1 1.8.4.6.9 1.4 1 1.9.1-.5.6-1.3 1-1.9 1.1-1.7 3.1-2.5 5.1-1.8 3.2 1.1 4.2 4.6 2.6 7.4C19.5 16.4 12 21 12 21z"/>
  </svg>
  <blockquote>jab bhi ready ho, baat karte hain — sahi se, shanti se.</blockquote>
  <div class="from">— Ahzaz</div>
</section>

<script>
  // ambient floating particles
  (function(){
    var wrap = document.getElementById('particles');
    var n = window.innerWidth < 500 ? 12 : 20;
    for(var i=0;i<n;i++){
      var p = document.createElement('div');
      p.className = 'particle';
      var left = Math.random()*100;
      var dur = 10 + Math.random()*9;
      var delay = Math.random()*12;
      var drift = (Math.random()*70 - 35) + 'px';
      var size = 8 + Math.random()*10;
      p.style.left = left + 'vw';
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.animationDuration = dur + 's';
      p.style.animationDelay = delay + 's';
      p.style.setProperty('--drift', drift);
      var color = Math.random() > 0.5 ? '#6E5FC4' : '#9FC2E8';
      p.innerHTML = '<svg viewBox="0 0 24 24" fill="' + color + '"><path d="M12 21s-7.5-4.6-10.2-9.1C.2 9.1 1.2 5.6 4.4 4.5c2-.7 4 .1 5.1 1.8.4.6.9 1.4 1 1.9.1-.5.6-1.3 1-1.9 1.1-1.7 3.1-2.5 5.1-1.8 3.2 1.1 4.2 4.6 2.6 7.4C19.5 16.4 12 21 12 21z"/></svg>';
      wrap.appendChild(p);
    }
  })();

  // envelope open
  (function(){
    var env = document.getElementById('envelope');
    var letter = document.getElementById('letter');
    var hint = document.getElementById('hint');
    var opened = false;
    function openEnvelope(){
      if(opened) return;
      opened = true;
      env.classList.add('open');
      setTimeout(function(){ letter.classList.add('show'); }, 350);
      hint.style.opacity = '0';
      setTimeout(function(){ hint.style.display='none'; }, 400);
    }
    env.addEventListener('click', openEnvelope);
    env.addEventListener('keypress', function(e){
      if(e.key === 'Enter' || e.key === ' ') openEnvelope();
    });
  })();

  // promise card flip
  (function(){
    var cards = document.querySelectorAll('.promise-card');
    cards.forEach(function(card){
      function toggle(){ card.classList.toggle('flipped'); }
      card.addEventListener('click', toggle);
      card.addEventListener('keypress', function(e){
        if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); }
      });
    });
  })();

  // forgive game — "no" dodges, "yes" always wins
  (function(){
    var stage = document.getElementById('forgiveStage');
    var yesBtn = document.getElementById('forgiveYes');
    var noBtn = document.getElementById('forgiveNo');
    var result = document.getElementById('forgiveResult');
    if(!stage || !yesBtn || !noBtn) return;
    var dodges = 0;
    var maxDodges = 4;

    function dodge(){
      if(dodges >= maxDodges){
        noBtn.classList.add('gone');
        result.textContent = 'dekha, "nahi" kehna bhi mushkil hai na?';
        return;
      }
      dodges++;
      var stageRect = stage.getBoundingClientRect();
      var btnRect = noBtn.getBoundingClientRect();
      var maxLeft = Math.max(stageRect.width - btnRect.width - 10, 10);
      var maxTop = Math.max(stageRect.height - btnRect.height - 10, 10);
      var newLeft = Math.random() * maxLeft;
      var newTop = Math.random() * maxTop;
      noBtn.style.transform = 'none';
      noBtn.style.left = newLeft + 'px';
      noBtn.style.top = newTop + 'px';
    }
    noBtn.addEventListener('mouseenter', dodge);
    noBtn.addEventListener('touchstart', function(e){ e.preventDefault(); dodge(); }, { passive:false });

    yesBtn.addEventListener('click', function(){
      result.textContent = 'shukriya, Rida. ab sahi se baat karte hain.';
    });
  })();
</script>

</body>
</html>
